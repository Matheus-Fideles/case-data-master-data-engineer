{
  "expectation_suite_name": "gold_dw_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": { "min_value": 1 },
      "meta": { "notes": "Gold DW não pode estar vazio após carga" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "sk_paciente" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "id_paciente_hash" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "dt_inicio" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "dt_fim" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "is_current" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "sk_paciente" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "id_paciente_hash" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "dt_inicio" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "dt_fim" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "is_current" }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": { "column": "sk_paciente" },
      "meta": { "notes": "SK é surrogate key — deve ser único" }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "id_paciente_hash",
        "regex": "^[0-9a-f]{64}$"
      },
      "meta": { "notes": "SHA-256 herdado do Silver — integridade end-to-end" }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "is_current",
        "value_set": [true, false]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "ano_nascimento",
        "min_value": 1900,
        "max_value": 2024
      },
      "meta": { "notes": "Generalização herdada do Silver" }
    },
    {
      "expectation_type": "expect_column_value_lengths_to_equal",
      "kwargs": { "column": "cep_regiao", "value": 3 },
      "meta": { "notes": "CEP truncado a 3 dígitos preservado do Silver (ADR-0004)" }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "sexo",
        "value_set": ["M", "F", "O"]
      }
    },
    {
      "expectation_type": "expect_column_to_not_exist",
      "kwargs": { "column": "cpf" },
      "meta": { "notes": "CRÍTICO: CPF não pode existir no Gold (LGPD)" }
    },
    {
      "expectation_type": "expect_column_to_not_exist",
      "kwargs": { "column": "nome" },
      "meta": { "notes": "LGPD: nome suprimido no Gold" }
    },
    {
      "expectation_type": "expect_column_to_not_exist",
      "kwargs": { "column": "email" },
      "meta": { "notes": "LGPD: email suprimido no Gold" }
    },
    {
      "expectation_type": "expect_column_to_not_exist",
      "kwargs": { "column": "telefone" },
      "meta": { "notes": "LGPD: telefone suprimido no Gold" }
    },
    {
      "expectation_type": "expect_column_to_not_exist",
      "kwargs": { "column": "data_nascimento" },
      "meta": { "notes": "LGPD: data_nascimento substituída por ano_nascimento" }
    }
  ],
  "meta": {
    "great_expectations_version": "0.18.0",
    "notes": "Suite de qualidade Gold DW dim_paciente — SCD2 + LGPD + integridade referencial"
  }
}
