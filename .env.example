# ============================================================
# .env.example — copiar para .env antes de rodar
# Valores abaixo são seguros para demo local.
# NUNCA commitar .env com credenciais reais.
# ============================================================

# ------------------------------------------------------------
# MinIO (S3-compatível)
# ------------------------------------------------------------
MINIO_ROOT_USER=minioadmin        # pragma: allowlist secret
MINIO_ROOT_PASSWORD=minioadmin    # pragma: allowlist secret
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_EXTERNAL=http://localhost:9000

# Buckets criados automaticamente pelo minio-init
MINIO_BUCKET_LANDING=landing
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# Service accounts IAM (criados pelo minio-init com políticas de least-privilege)
# svc-pipeline: rw em todos os buckets — usado por Spark e Airflow
MINIO_SVC_PIPELINE_USER=svc-pipeline       # pragma: allowlist secret
MINIO_SVC_PIPELINE_PASSWORD=pipeline-secret-change-me  # pragma: allowlist secret
# svc-serving: somente leitura em gold — usado por Trino/Metabase
MINIO_SVC_SERVING_USER=svc-serving         # pragma: allowlist secret
MINIO_SVC_SERVING_PASSWORD=serving-secret-change-me    # pragma: allowlist secret

# ------------------------------------------------------------
# Postgres (único container, 4 schemas)
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres        # pragma: allowlist secret

# Conexão JDBC para jobs Spark
POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/app

# Credenciais por schema (roles criados em infra/postgres/init/02-roles.sql)
POSTGRES_GOLD_USER=gold_engineer
POSTGRES_GOLD_PASSWORD=gold_engineer  # pragma: allowlist secret

# Hive Metastore — schema 'hive' no Postgres (lido por hive-site.xml via ${env.VAR})
POSTGRES_HIVE_USER=hive
POSTGRES_HIVE_PASSWORD=hive           # pragma: allowlist secret

# ------------------------------------------------------------
# Airflow
# ------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/app
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nIe3aY=  # pragma: allowlist secret
AIRFLOW__WEBSERVER__SECRET_KEY=supersecretkey                              # pragma: allowlist secret
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__OPENLINEAGE__TRANSPORT={"type": "http", "url": "http://marquez:5000", "endpoint": "api/v1/lineage"}
AIRFLOW__OPENLINEAGE__NAMESPACE=case-santander
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin      # pragma: allowlist secret

# Conexões Airflow (também podem ser criadas via make airflow-setup)
AIRFLOW_CONN_MINIO=aws://minioadmin:minioadmin@?endpoint_url=http%3A%2F%2Fminio%3A9000&region_name=us-east-1

# ------------------------------------------------------------
# Kafka (KRaft — sem Zookeeper)
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=localhost:19092
KAFKA_TOPIC_NOTIFICACOES=notificacoes.raw
KAFKA_TOPIC_DLQ=notificacoes.dlq

# ------------------------------------------------------------
# Mascaramento PII — LGPD
# ------------------------------------------------------------
PII_SALT=changeme-in-production-use-secrets-manager  # pragma: allowlist secret
# Salt usado no SHA-256 do CPF. Em produção: AWS Secrets Manager / Vault.

# ------------------------------------------------------------
# Pipeline — comportamento
# ------------------------------------------------------------
OFFLINE_MODE=0
# 1 = usa dados cacheados em data/raw/ (sem chamada à API)
# 0 = chama API apidadosabertos.saude.gov.br

API_BASE_URL=https://apidadosabertos.saude.gov.br
API_PAGE_SIZE=100
API_MAX_RETRIES=5

# Ano de referência para extração de dados históricos
DATA_REF_ANO=2024

# ------------------------------------------------------------
# Spark via DockerOperator (local[2]) — sem k8s necessário
# ------------------------------------------------------------
# Imagem local buildada por `make spark-image-local` (incluso em `make demo`)
SPARK_LOCAL_IMAGE=spark-custom:3.5-delta
# Rede Docker onde Spark e serviços (minio, postgres) se comunicam
SPARK_DOCKER_NETWORK=lake

# ------------------------------------------------------------
# Trino
# ------------------------------------------------------------
TRINO_HOST=trino
TRINO_PORT=8085
TRINO_USER=trino
TRINO_CATALOG_DELTA=delta

# ------------------------------------------------------------
# Marquez (OpenLineage)
# ------------------------------------------------------------
MARQUEZ_HOST=marquez
MARQUEZ_PORT=5000
OPENLINEAGE_URL=http://marquez:5000
OPENLINEAGE_NAMESPACE=case-santander

# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=admin    # pragma: allowlist secret
GF_SERVER_HTTP_PORT=3000

# ------------------------------------------------------------
# Metabase — BI layer (serving profile, :3001)
# ------------------------------------------------------------
# Banco interno do Metabase (H2 embarcado, persistido em volume metabase-data)
MB_DB_TYPE=h2
MB_DB_FILE=/metabase-data/metabase.db
JAVA_TIMEZONE=America/Sao_Paulo
# Conexão com Trino (configurar na UI na 1ª vez: host=trino port=8080 catalog=delta schema=gold)
TRINO_METABASE_HOST=trino
TRINO_METABASE_PORT=8080

# ------------------------------------------------------------
# Docker (Spark via DockerOperator)
# ------------------------------------------------------------
# GID do grupo docker no host — stat -c '%g' /var/run/docker.sock
# Linux padrão: 999 | Rancher Desktop (Lima): 102 | Docker Desktop Mac: 999
DOCKER_GID=999
# Caminho do socket Docker (sobrescrever apenas se necessário)
# DOCKER_SOCK=/var/run/docker.sock
